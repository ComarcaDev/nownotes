{
  "name": "apunta",
  "private": true,
  "version": "1.0.0",
  "description": "Notas y tareas rápidas para Windows, con recordatorios.",
  "license": "MIT",
  "author": "hujeanpaes",
  "repository": {
    "type": "git",
    "url": "https://github.com/hujeanpaes/apunta.git"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "check": "svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
    "test": "cargo test --manifest-path src-tauri/Cargo.toml",
    "tauri": "tauri",
    "release": "tauri build && powershell -ExecutionPolicy Bypass -File scripts/make-portable.ps1"
  },
  "dependencies": {
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-autostart": "^2",
    "@tauri-apps/plugin-dialog": "^2",
    "@tauri-apps/plugin-opener": "^2"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^5",
    "@tauri-apps/cli": "^2",
    "@tsconfig/svelte": "^5",
    "svelte": "^5",
    "svelte-check": "^4.7.8",
    "typescript": "^5",
    "vite": "^6"
  }
}
